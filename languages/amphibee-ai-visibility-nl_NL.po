msgid "Dashboard"
msgstr "Dashboard"

#: src/Admin/SettingsPage.php:39
msgid "Files and health checks"
msgstr "Bestanden en controles"

#: src/Admin/SettingsPage.php:42 src/Admin/SettingsPage.php:451
