# Line endings — normalise in the repository, check out per platform.
* text=auto eol=lf
*.php text eol=lf
*.js  text eol=lf
*.md  text eol=lf
*.png binary
*.jpg binary
*.gif binary

# ---------------------------------------------------------------------------
# Everything below is development-only and must not reach the distributed zip.
# `git archive` honours export-ignore; the release workflow builds from it.
# ---------------------------------------------------------------------------
/.github            export-ignore
/.wordpress-org     export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/tests              export-ignore
/phpunit.xml.dist   export-ignore
/phpstan.neon.dist  export-ignore
/phpcs.xml.dist     export-ignore
/pint.json          export-ignore
/composer.lock      export-ignore
/CONTRIBUTING.md    export-ignore
/SECURITY.md        export-ignore
/.phpunit.cache     export-ignore
