#. Plugin Name of the plugin
#: ai-visibility.php
msgid "AmphiBee AI Visibility"
msgstr "AmphiBee AI Visibility"

#. Description of the plugin
#: ai-visibility.php
msgid "Maximize site visibility for AI engines — llms.txt, Markdown endpoints, robots.txt AI directives, AI discovery files, and MCP abilities."
msgstr "Massimizza la visibilità del sito per i motori IA — llms.txt, endpoint Markdown, direttive IA in robots.txt, file di discovery IA e abilità MCP."

#. Author of the plugin
#: ai-visibility.php
msgid "AmphiBee"
msgstr "AmphiBee"

#. Author URI of the plugin
#: ai-visibility.php
msgid "https://amphibee.fr"
msgstr "https://amphibee.fr"

#: ai-visibility.php:43
msgid "AI Visibility cannot find its classes. Install the plugin with Composer, or from a release zip."
msgstr "AI Visibility non trova le sue classi. Installa il plugin con Composer o da uno ZIP di rilascio."

#: src/Abilities/Registration.php:21 src/Admin/SettingsPage.php:121
#: src/Admin/SettingsPage.php:122 src/Admin/SettingsPage.php:289
msgid "AI Visibility"
msgstr "AI Visibility"

#: src/Abilities/Registration.php:22
msgid "AI discoverability and visibility tools"
msgstr "Strumenti di scopribilità e visibilità per l'IA"

#: src/Abilities/Registration.php:29
msgid "Get llms.txt"
msgstr "Ottieni llms.txt"

#: src/Abilities/Registration.php:30
msgid "Returns the llms.txt content — a structured index of the site for LLMs"
msgstr "Restituisce il contenuto di llms.txt — un indice strutturato del sito per gli LLM"

#: src/Abilities/Registration.php:36
msgid "Regenerate AI files"
msgstr "Rigenera i file IA"

#: src/Abilities/Registration.php:37
msgid "Regenerates all AI visibility files (llms.txt, llms-full.txt, ai.txt, identity.json)"
msgstr "Rigenera tutti i file di visibilità IA (llms.txt, llms-full.txt, ai.txt, identity.json)"

#: src/Abilities/Registration.php:52
msgid "Get site summary"
msgstr "Ottieni il riepilogo del sito"

#: src/Abilities/Registration.php:53
msgid "Returns a structured summary of the site for AI agents"
msgstr "Restituisce un riepilogo strutturato del sito per gli agenti IA"

#: src/Admin/Diagnostics.php:71
msgid "Pretty permalinks"
msgstr "Permalink leggibili"

#: src/Admin/Diagnostics.php:73
msgid "Rewrite rules can resolve the endpoints."
msgstr "Le regole di rewrite possono risolvere gli endpoint."

#: src/Admin/Diagnostics.php:74
msgid "Set to anything but \"Plain\" under Settings → Permalinks, or every endpoint answers 404."
msgstr "Imposta qualcosa di diverso da \"Semplice\" in Impostazioni → Permalink, altrimenti ogni endpoint risponde 404."

#: src/Admin/Diagnostics.php:88
msgid "Writable cache directory"
msgstr "Cartella cache scrivibile"

#: src/Admin/Diagnostics.php:90
msgid "Generated files are stored in the uploads folder."
msgstr "I file generati vengono salvati nella cartella uploads."

#: src/Admin/Diagnostics.php:91
msgid "The uploads folder is not writable, so regeneration cannot store anything."
msgstr "La cartella uploads non è scrivibile, quindi la rigenerazione non può salvare nulla."

#: src/Admin/Diagnostics.php:105
msgid "Site visible to crawlers"
msgstr "Sito visibile ai crawler"

#: src/Admin/Diagnostics.php:107
msgid "robots.txt carries the AI crawler directives."
msgstr "robots.txt contiene le direttive per i crawler IA."

#: src/Admin/Diagnostics.php:108
msgid "\"Discourage search engines\" is on, so the AI directives are withheld from robots.txt."
msgstr "L'opzione \"Scoraggia i motori di ricerca\" è attiva, quindi le direttive IA sono assenti da robots.txt."

#: src/Admin/Diagnostics.php:128
msgid "Files generated"
msgstr "File generati"

#: src/Admin/Diagnostics.php:130
msgid "All four files are on disk."
msgstr "Tutti e quattro i file sono presenti su disco."

#. translators: %s: comma-separated list of file names.
#: src/Admin/Diagnostics.php:133
#, php-format
msgid "Not generated yet: %s. They are built on first request, or now with the button above."
msgstr "Non ancora generati: %s. Vengono creati alla prima richiesta, oppure ora con il pulsante qui sopra."

#: src/Admin/Diagnostics.php:149
msgid "Abilities API"
msgstr "API Abilities"

#: src/Admin/Diagnostics.php:151
msgid "MCP clients can call this site through the Abilities API."
msgstr "I client MCP possono interrogare questo sito tramite l'API Abilities."

#: src/Admin/Diagnostics.php:152
msgid "Requires WordPress 6.9 or newer. Everything else works without it."
msgstr "Richiede WordPress 6.9 o versioni successive. Tutto il resto funziona comunque."

