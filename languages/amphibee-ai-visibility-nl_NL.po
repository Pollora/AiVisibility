msgstr "Inhoud"

#: src/Admin/SettingsPage.php:47
msgid "What goes into the files"
msgstr "Wat in de bestanden komt"

#: src/Admin/SettingsPage.php:50 src/Admin/SettingsPage.php:557
msgid "AI crawlers"
msgstr "AI-crawlers"

#: src/Admin/SettingsPage.php:51
msgid "Who may read the site"
msgstr "Wie de site mag lezen"

#: src/Admin/SettingsPage.php:54 src/Admin/SettingsPage.php:599
msgid "Identity"
msgstr "Identiteit"

#: src/Admin/SettingsPage.php:55
msgid "Who publishes it"
msgstr "Wie het publiceert"

#: src/Admin/SettingsPage.php:208
msgid "You are not allowed to regenerate these files."
msgstr "Je hebt geen toestemming om deze bestanden opnieuw te genereren."

#. translators: %s: comma-separated list of file names.
#: src/Admin/SettingsPage.php:219
#, php-format
msgid "Could not write: %s. Check that the uploads directory is writable."
msgstr "Kon niet schrijven: %s. Controleer of de map uploads beschrijfbaar is."

#: src/Admin/SettingsPage.php:226
msgid "All files regenerated."
msgstr "Alle bestanden zijn opnieuw gegenereerd."

#: src/Admin/SettingsPage.php:259
msgid "Regenerating…"
msgstr "Opnieuw genereren…"

#: src/Admin/SettingsPage.php:260
msgid "Regeneration failed."
msgstr "Opnieuw genereren mislukt."

#: src/Admin/SettingsPage.php:261
msgid "Copied"
msgstr "Gekopieerd"

#: src/Admin/SettingsPage.php:262
msgid "Press Ctrl+C to copy"
msgstr "Druk op Ctrl+C om te kopiëren"

#: src/Admin/SettingsPage.php:272
msgid "Everything checks out"
msgstr "Alles in orde"

#: src/Admin/SettingsPage.php:273
msgid "Needs attention"
msgstr "Vereist aandacht"

#: src/Admin/SettingsPage.php:274
msgid "Action required"
msgstr "Actie vereist"

#: src/Admin/SettingsPage.php:290
msgid "What this site publishes for LLMs, AI search and AI agents."
msgstr "Wat deze site publiceert voor LLM's, AI-zoekmachines en AI-agents."

#: src/Admin/SettingsPage.php:306
msgid "Settings sections"
msgstr "Instellingsonderdelen"

#: src/Admin/SettingsPage.php:343
msgid "Files are rebuilt automatically when a tracked post is saved."
msgstr "Bestanden worden automatisch opnieuw opgebouwd zodra een gevolgd bericht wordt opgeslagen."

#: src/Admin/SettingsPage.php:344
msgid "Save changes"
msgstr "Wijzigingen opslaan"

#: src/Admin/SettingsPage.php:368
msgid "The files this site publishes, and whether anything is stopping them from being served."
msgstr "De bestanden die deze site publiceert, en of er iets is dat verhindert dat ze worden geleverd."

#: src/Admin/SettingsPage.php:386
msgid "Regenerate all files"
msgstr "Alle bestanden opnieuw genereren"

#: src/Admin/SettingsPage.php:413
msgid "Size"
msgstr "Grootte"

#: src/Admin/SettingsPage.php:415
msgid "Updated"
msgstr "Bijgewerkt"

#: src/Admin/SettingsPage.php:416
msgid "Not generated"
msgstr "Niet gegenereerd"

#: src/Admin/SettingsPage.php:418
msgid "View"
msgstr "Bekijken"

#: src/Admin/SettingsPage.php:419
msgid "Copy URL"
msgstr "URL kopiëren"

#: src/Admin/SettingsPage.php:425
msgid "Checks"
msgstr "Controles"

#: src/Admin/SettingsPage.php:452
msgid "Which formats this site publishes. Turning one off removes its endpoint entirely."
msgstr "Welke formaten deze site publiceert. Eentje uitzetten verwijdert het bijbehorende eindpunt volledig."

#: src/Admin/SettingsPage.php:459
msgid "llms.txt and llms-full.txt"
msgstr "llms.txt en llms-full.txt"

#: src/Admin/SettingsPage.php:460
msgid "A structured index of the site, and one document containing every tracked page."
msgstr "Een gestructureerde index van de site, en één document met elke gevolgde pagina."

#: src/Admin/SettingsPage.php:465
msgid "Markdown for every page"
msgstr "Markdown voor elke pagina"

#: src/Admin/SettingsPage.php:466
msgid "Serves /any-page.md and ?format=md, and advertises it from the HTML page."
msgstr "Levert /any-page.md en ?format=md, en kondigt dit aan vanaf de HTML-pagina."

#: src/Admin/SettingsPage.php:471
msgid "AI directives in robots.txt"
msgstr "AI-richtlijnen in robots.txt"

#: src/Admin/SettingsPage.php:472
msgid "Adds an explicit Allow or Disallow block per AI crawler."
msgstr "Voegt een expliciet Allow- of Disallow-blok toe per AI-crawler."

#: src/Admin/SettingsPage.php:477
msgid "Discovery files"
msgstr "Ontdekkingsbestanden"

#: src/Admin/SettingsPage.php:478
msgid "Publishes ai.txt and identity.json under /.well-known/ and /ai-discovery/."
msgstr "Publiceert ai.txt en identity.json onder /.well-known/ en /ai-discovery/."

#: src/Admin/SettingsPage.php:483
msgid "MCP abilities"
msgstr "MCP-mogelijkheden"

#: src/Admin/SettingsPage.php:484
msgid "Lets an MCP client query this site directly. Requires WordPress 6.9 or newer."
msgstr "Laat een MCP-client deze site rechtstreeks bevragen. Vereist WordPress 6.9 of nieuwer."

#: src/Admin/SettingsPage.php:500
msgid "What goes into the generated files, and how much of it."
msgstr "Wat er in de gegenereerde bestanden komt, en hoeveel daarvan."

#: src/Admin/SettingsPage.php:505
msgid "How to describe this site"
msgstr "Hoe deze site te beschrijven"

#: src/Admin/SettingsPage.php:506
msgid "What the site is, who it serves, what it covers. Appears at the top of llms.txt, ai.txt and identity.json. Left empty, the WordPress tagline is used."
msgstr "Wat de site is, voor wie hij bedoeld is, wat hij behandelt. Verschijnt bovenaan llms.txt, ai.txt en identity.json. Blijft dit leeg, dan wordt de WordPress-tagline gebruikt."

#: src/Admin/SettingsPage.php:509
msgid "A small design studio building websites and brand identities for independent shops and restaurants."
msgstr "Een klein designstudio dat websites en merkidentiteiten bouwt voor onafhankelijke winkels en restaurants."

#: src/Admin/SettingsPage.php:515
msgid "Post types to publish"
msgstr "Te publiceren berichttypen"

#: src/Admin/SettingsPage.php:516
msgid "Only public post types are listed. Attachments are never included."
msgstr "Alleen openbare berichttypen worden weergegeven. Bijlagen worden nooit meegenomen."

#: src/Admin/SettingsPage.php:539
msgid "Entries per post type"
msgstr "Items per berichttype"

#: src/Admin/SettingsPage.php:540
msgid "An upper bound per type, so llms.txt stays readable on a large site."
msgstr "Een bovengrens per type, zodat llms.txt leesbaar blijft op een grote site."

#: src/Admin/SettingsPage.php:558
msgid "One crawler name per line. These become User-agent blocks in robots.txt."
msgstr "Eén crawlernaam per regel. Deze worden User-agent-blokken in robots.txt."

#: src/Admin/SettingsPage.php:565
msgid "Allowed"
msgstr "Toegestaan"

#: src/Admin/SettingsPage.php:566
msgid "Crawlers that answer questions and cite sources. Allowing them is how the site gets quoted."
msgstr "Crawlers die vragen beantwoorden en bronnen citeren. Ze toestaan is hoe de site geciteerd wordt."

#: src/Admin/SettingsPage.php:574
msgid "Blocked"
msgstr "Geblokkeerd"

#: src/Admin/SettingsPage.php:575
msgid "Crawlers that collect training data without attribution."
msgstr "Crawlers die trainingsdata verzamelen zonder bronvermelding."

#: src/Admin/SettingsPage.php:585
msgid "A crawler named in neither list is not mentioned in robots.txt at all, and follows whatever your general rules say."
msgstr "Een crawler die in geen van beide lijsten voorkomt, wordt helemaal niet vermeld in robots.txt en volgt je algemene regels."

#: src/Admin/SettingsPage.php:600
msgid "Who is behind the site. Published in identity.json as a schema.org Organization."
msgstr "Wie er achter de site zit. Gepubliceerd in identity.json als een schema.org Organization."

#: src/Admin/SettingsPage.php:612
msgid "Contact email"
msgstr "Contact-e-mailadres"

#: src/Admin/SettingsPage.php:613
msgid "Where an AI agent or its operator should write. Defaults to the site administrator."
msgstr "Waar een AI-agent of de beheerder ervan naartoe moet schrijven. Standaard de sitebeheerder."

#: src/Admin/SettingsPage.php:620
msgid "Profiles elsewhere"
msgstr "Profielen elders"

#: src/Admin/SettingsPage.php:621
msgid "One URL per line. Published as sameAs, which is how an engine confirms two profiles are the same organisation."
msgstr "Eén URL per regel. Gepubliceerd als sameAs, waarmee een engine bevestigt dat twee profielen dezelfde organisatie zijn."

#. translators: %s: number of published entries.
#: src/Admin/SettingsPage.php:667
#, php-format
msgid "%s published"
msgid_plural "%s published"
msgstr[0] "%s gepubliceerd"
msgstr[1] "%s gepubliceerd"